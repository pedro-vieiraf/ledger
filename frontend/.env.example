# URL base da API do backend (Web, iOS e fallback do Android)
EXPO_PUBLIC_API_URL=http://localhost:8080

# URL base da API no Android — use o IP do computador acessível pelo aparelho
# (por exemplo, o IP Tailscale). Se não for definida, o Android usa a URL acima.
EXPO_PUBLIC_API_URL_ANDROID=http://SEU-IP-TAILSCALE:8080
